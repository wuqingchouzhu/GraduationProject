# ==========================================
# 进销存管理系统 环境变量配置模板
# 复制此文件为 .env 并填写真实值
# 生产环境请勿使用默认值！
# ==========================================

# MySQL 数据库
DB_URL=jdbc:mysql://localhost:3306/inventory_db?serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
